# =============================================================================
# PHARMACY MANAGER — LOCAL / RAILWAY ENVIRONMENT
# =============================================================================
# Never commit a real .env file.

SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=True
TIME_ZONE=Africa/Dar_es_Salaam
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# LOCAL: leave DATABASE_URL empty to use SQLite.
DATABASE_URL=
SQLITE_PATH=db.sqlite3

# RAILWAY: attach PostgreSQL. Railway provides DATABASE_URL automatically.
# Do not hard-code production database credentials in this file.

# -----------------------------------------------------------------------------
# Media bucket — S3-compatible storage
# Supports AWS S3, Cloudflare R2 and other S3-compatible object storage.
# Leave these empty for local Android-safe filesystem storage.
# -----------------------------------------------------------------------------
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
AWS_S3_ADDRESSING_STYLE=auto

# -----------------------------------------------------------------------------
# Deployment / operations
# -----------------------------------------------------------------------------
RAILWAY_PUBLIC_DOMAIN=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Local-only backup directory. For production, use PostgreSQL backups and
# the configured object-storage bucket for uploaded media.
BACKUP_DIR=backups

# Africa's Talking credentials are intentionally managed through Django Admin
# by the System Administrator and are not stored here.

# -----------------------------------------------------------------------------
# AI Assistant (floating help chatbot) — see docs/ASSISTANT.md
# Get a key at https://console.anthropic.com/ . Leave empty to hide the chatbot.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=True
ASSISTANT_MODEL=claude-haiku-4-5-20251001
# Technical Support numbers the assistant gives to customers (comma-separated)
SUPPORT_PHONES=+255610117824,+255678828519
# Seconds of silence before the assistant checks in on a customer ("Are you still there?")
ASSISTANT_IDLE_SECONDS=60

# Returns / voids: hours after a sale during which an EMPLOYEE may request a return (owners have no limit).
SALE_RETURN_EMPLOYEE_WINDOW_HOURS=24

# -----------------------------------------------------------------------------
# Scaling / production hardening - see docs/SCALING_AND_PRODUCTION.md
# -----------------------------------------------------------------------------
# Shared cache (Railway Redis service). On Railway set it as a reference variable: ${{Redis.REDIS_URL}}
# Leave empty for local development (falls back to a per-process in-memory cache).
REDIS_URL=
# Simultaneous requests = WEB_CONCURRENCY x GUNICORN_THREADS (each worker needs ~150-250 MB RAM)
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1500
# Per-request access logs (1 = on). Off by default because the app polls and would flood the logs.
GUNICORN_ACCESS_LOG=0
LOG_LEVEL=INFO

# Premium Daily Sales Intelligence
# Public HTTPS base used in SMS report links (e.g. https://mringobey.store).
DAILY_REPORT_PUBLIC_BASE_URL=https://mringobey.store

# -----------------------------------------------------------------------------
# Background Meal Push Notifications (Web Push / VAPID)
# Generate a VAPID key pair once and keep the private key secret.
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_CLAIMS_EMAIL=mailto:admin@yourdomain.com

# Daily cash control automation
CASH_AUTO_CLOSE_ENABLED=true

# WhatsApp support widget
SUPPORT_WHATSAPP_PHONE=+255610117824
SUPPORT_ADMIN_USERNAME=

# Trusted-device idle lock: keep the authenticated account signed in; require PIN after inactivity.
DEVICE_PIN_IDLE_LOCK_MINUTES=5
